    - Key: April
      Language: 6
      Section: Months
      WordKey: Thai/Vocabulary/Months/April
      ImageKey: Thai/Vocabulary/Months/April
      SoundKey: Thai/Vocabulary/Months/April
      LearnWord: "\u0E40\u0E21\u0E29\u0E32\u0E22\u0E19"
