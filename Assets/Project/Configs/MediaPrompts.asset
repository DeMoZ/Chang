    - Key: Standard sweet
      Language: 6
      Section: Sweetnes
      WordKey: Thai/Vocabulary/Sweetnes/Standard sweet
      ImageKey: Thai/Vocabulary/Sweetnes/Standard sweet
      SoundKey: Thai/Vocabulary/Sweetnes/Standard sweet
      LearnWord: "\u0E2B\u0E27\u0E32\u0E19\u0E1B\u0E01\u0E15\u0E34"
      Translation: Standard sweet
