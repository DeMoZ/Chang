      Language: 6
      Section: Beverages
      WordKey: Thai/Vocabulary/Beverages/Glass_mug_cup
      ImageKey: Thai/Vocabulary/Beverages/Glass_mug_cup
      SoundKey: Thai/Vocabulary/Beverages/Glass_mug_cup
