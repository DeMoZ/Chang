    - Key: Daughter
      Language: 6
      Section: FamilyAndPeople
      WordKey: Thai/Vocabulary/FamilyAndPeople/Daughter
      ImageKey: Thai/Vocabulary/FamilyAndPeople/Daughter
      SoundKey: Thai/Vocabulary/FamilyAndPeople/Daughter
      LearnWord: "\u0E25\u0E39\u0E01\u0E2A\u0E32\u0E27"
