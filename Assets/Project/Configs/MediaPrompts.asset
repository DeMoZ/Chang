      Language: 6
      Section: Beverages
      WordKey: Thai/Vocabulary/Beverages/Bottle
      ImageKey: Thai/Vocabulary/Beverages/Bottle
      SoundKey: Thai/Vocabulary/Beverages/Bottle
      LearnWord: "\u0E02\u0E27\u0E14"
