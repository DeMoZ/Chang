    - Key: Dad
      Language: 6
      Section: FamilyAndPeople
      WordKey: Thai/Vocabulary/FamilyAndPeople/Dad
      ImageKey: Thai/Vocabulary/FamilyAndPeople/Dad
      SoundKey: Thai/Vocabulary/FamilyAndPeople/Dad
      LearnWord: "\u0E1E\u0E48\u0E2D"
